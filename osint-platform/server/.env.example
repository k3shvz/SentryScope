PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Auth — generate your own strong secret, e.g. run this once and paste the
# output below: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Keep it private and never commit it to git.
JWT_SECRET=replace-this-with-a-long-random-string-see-README
JWT_EXPIRES_IN=7d

# MongoDB — REQUIRED. The server will refuse to start without this.
# Get a free cluster at https://www.mongodb.com/cloud/atlas/register, then
# replace the line below with your own connection string (Atlas → Connect →
# "Drivers" gives you this exact format — just swap in your username/password
# and pick a database name, e.g. "sentryscope").
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sentryscope?retryWrites=true&w=majority

# Contact form + password reset emails (SMTP). Without this, both features
# still work end-to-end but the message/reset-link is only printed to the
# server console instead of actually emailed — fine for local testing, not
# for a live site. For Gmail: enable 2FA on the account, then create an
# "App Password" at https://myaccount.google.com/apppasswords and use that
# (not your normal password) as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
# Where contact-form submissions get emailed TO. Set this to your real inbox.
CONTACT_EMAIL=your-real-email@example.com

# Optional OSINT integrations — leave blank to skip these checks gracefully.
# HIBP_API_KEY: https://haveibeenpwned.com/API/Key (paid, ~$4/mo)
# HUNTER_API_KEY: https://hunter.io/api-keys (free tier available)
HIBP_API_KEY=
HUNTER_API_KEY=
